{
  "name": "raw-inspector",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev",
    "pages:deploy": "npm run build && wrangler pages deploy",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "^3.5.42",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.145.0"
  },
  "description": "The easiest and quickest way to inspect the structure and contents of a RAW image file.",
  "allowScripts": {
    "workerd@1.20260930.2": true,
    "esbuild@0.28.1": true
  }
}
